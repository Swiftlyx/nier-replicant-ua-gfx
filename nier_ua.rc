#include <winver.h>
#include "version.h"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION NIERUA_VERSION_NUM
 PRODUCTVERSION NIERUA_VERSION_NUM
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", PLUGIN_AUTHOR
            VALUE "FileDescription", "Game code changes for the Ukrainian translation of NieR Replicant ver.1.22474487139"
            VALUE "FileVersion", NIERUA_VERSION_STR
            VALUE "InternalName", "NierReplicantUA"
            VALUE "LegalCopyright", "Copyright (C) 2026 " PLUGIN_AUTHOR
            VALUE "OriginalFilename", "NierReplicantUA.dll"
            VALUE "ProductName", "NieR Replicant Ukrainian Translation"
            VALUE "ProductVersion", NIERUA_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
